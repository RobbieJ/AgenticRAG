# =============================================================================
#  Agentic RAG — backend configuration
#
#  All three providers live in this one file. Fill in whatever credentials you
#  have (you can keep keys for ALL of them at once), then switch provider by
#  changing the SINGLE line below — nothing else needs to change.
#
#  A provider selected with no credentials runs in DEMO mode (offline,
#  deterministic answers), so the app works out of the box with this file blank.
#
#  Copy this file to `backend/.env` and edit:  cp backend/.env.example backend/.env
# =============================================================================

# ▼▼▼ The ONLY line you change to switch providers:  anthropic | openai | vllm
LLM_PROVIDER=anthropic
# ▲▲▲

# --- anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_ANSWER_MODEL=claude-sonnet-4-6

# --- openai (or any OpenAI-compatible hosted API) ----------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=gpt-4o

# --- vllm (local, OpenAI-compatible server) ----------------------------------
#   start it first, e.g.:  vllm serve meta-llama/Llama-3.1-8B-Instruct --port 8001
#   then set VLLM_MODEL to the exact served model name (required to leave DEMO mode)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=

# --- agentic loop tuning (provider-independent) ------------------------------
MAX_ITERATIONS=3
EVALUATION_THRESHOLD=0.7
RETRIEVAL_TOP_K=4

# --- CORS (JSON array) -------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
