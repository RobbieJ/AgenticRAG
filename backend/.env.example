# =============================================================================
# Choose ONE LLM provider. Leave its credentials blank to run in DEMO mode
# (offline, deterministic answers — the whole UI still works).
#   anthropic | openai | vllm
# =============================================================================
LLM_PROVIDER=anthropic

# --- anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_ANSWER_MODEL=claude-sonnet-4-6

# --- openai (or any OpenAI-compatible hosted API) ----------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=gpt-4o

# --- vllm (local, OpenAI-compatible server) ----------------------------------
# Start your server first, e.g.:
#   vllm serve meta-llama/Llama-3.1-8B-Instruct --port 8001
# Then set VLLM_MODEL to the exact served model name (required to leave DEMO mode).
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=

# --- Agentic loop tuning -----------------------------------------------------
MAX_ITERATIONS=3
EVALUATION_THRESHOLD=0.7
RETRIEVAL_TOP_K=4

# --- CORS (JSON array) -------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
