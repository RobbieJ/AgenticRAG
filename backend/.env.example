# Leave ANTHROPIC_API_KEY empty to run in DEMO mode (offline, deterministic answers).
# Set it to run the agentic-loop demo against real Claude models.
ANTHROPIC_API_KEY=

# Models (override only if you have a reason to)
FAST_MODEL=claude-haiku-4-5
ANSWER_MODEL=claude-sonnet-4-6

# Agentic loop tuning
MAX_ITERATIONS=3
EVALUATION_THRESHOLD=0.7
RETRIEVAL_TOP_K=4

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
